   1 0000               # FILE:         $File$
   2 0000               # AUTHOR:       P. White
   3 0000               # CONTRIBUTORS: M. Reek
   4 0000               # 		Ethan Chang
   5 0000               #
   6 0000               # DESCRIPTION:
   7 0000               #  	This is a simple program to find the prime numbers between 3 - 101
   8 0000               #	inclusive.  This is done by using the simple algorithm where a 
   9 0000               #	number 'n' is prime if no number between 2 and n-1 divides evenly 
  10 0000               #	into 'n'
  11 0000               #
  12 0000               # ARGUMENTS:
  13 0000               #       None
  14 0000               #
  15 0000               # INPUT:
  16 0000               #	none
  17 0000               #
  18 0000               # OUTPUT:
  19 0000               #	the prime numbers printed 1 to a line
  20 0000               #
  21 0000               # REVISION HISTORY:
  22 0000               #       Dec  03         - P. White, created program
  23 0000               #       Mar  04         - M. Reek, added named constants
  24 0000               #
  25 0000               
  26 0000               #
  27 0000               # CONSTANT DECLARATIONS
  28 0000               #
  29 0000               PRINT_INT	= 1		# code for syscall to print integer
  30 0000               PRINT_STRING	= 4		# code for syscall to print a string
  31 0000               MIN		= 3		# minimum value to check
  32 0000               MAX		= 102		# max value to check
  33 0000               
  34 0000               #
  35 0000               # DATA DECLARATIONS
  36 0000               #
  37 0000               	.data
  38 0000               newline:
  39 0000 0A00    		.asciiz "\n"
  40 0002               #
  41 0002               # MAIN PROGRAM
  42 0002               #
  43 0000               	.text
  44 0000               	.align	2
  45 0000               	.globl	main
  46 0000               main:
  47 0000 23BDFFF8	        addi    $sp,$sp,-8  	# space for return address/doubleword aligned
  48 0004 AFBF0000	        sw      $ra, 0($sp)     # store the ra on the stack
  49 0008               
  50 0008 0C000006		jal	find_primes
  51 000c               
  52 000c                       #
  53 000c                       # Now exit the program.
  54 000c               	#
  55 000c 8FBF0000	        lw      $ra, 0($sp)	# clean up stack
  56 0010 23BD0008	        addi    $sp,$sp,8
  57 0014 03E00008	        jr      $ra
  58 0018               
  59 0018               #
  60 0018               # Name:		find_primes 
  61 0018               #
  62 0018               # Description:	find the prime numbers between 3 and 101 inclusive.
  63 0018               # Coding Notes:	This function must call is_prime to determine if a
  64 0018               #		number is prime, and based on the return value of 
  65 0018               #		is_prime, call print_number to print that prime 
  66 0018               # Arguments:	none
  67 0018               # Returns:	nothing
  68 0018               #
  69 0018               
  70 0018               find_primes:
  71 0018 23BDFFD8	        addi    $sp,$sp,-40     # allocate stack frame (on doubleword boundary)
  72 001c AFBF0020	        sw      $ra, 32($sp)    # store the ra & s reg's on the stack
  73 0020 AFB7001C	        sw      $s7, 28($sp)
  74 0024 AFB60018	        sw      $s6, 24($sp)
  75 0028 AFB50014	        sw      $s5, 20($sp)
  76 002c AFB40010	        sw      $s4, 16($sp)
  77 0030 AFB3000C	        sw      $s3, 12($sp)
  78 0034 AFB20008	        sw      $s2, 8($sp)
  79 0038 AFB10004	        sw      $s1, 4($sp)
  80 003c AFB00000	        sw      $s0, 0($sp)
  81 0040               
  82 0040               # ######################################
  83 0040               # ##### BEGIN STUDENT CODE BLOCK 1 #####
  84 0040               
  85 0040                       # Assume we loop from numbers between 3 to 101 and test them for being prime
  86 0040               
  87 0040 34100003	        li      $s0, MIN            # Set s0 = MIN (3)
  88 0044                       
  89 0044               search_loop:
  90 0044               
  91 0044 34080066	        li      $t0, MAX            # Set s1 = MAX (101)
  92 0048               
  93 0048               
  94 0048 0208082A	        bge     $s0, $t0, Exit      # if s0 (3) is greater than or equal to MAX, then EXIT
     004c 10200008
  95 0050               
  96 0050 02002021	        move    $a0, $s0            # recall that this is functional arguments  
  97 0054               
  98 0054 0C000027	        jal     is_prime            # calls the function, is_prime
  99 0058               
 100 0058 10400003	        beq     $v0, $zero, skip    # if it's not prime, it moves on to next integer            
 101 005c               
 102 005c 0C000048	        jal     print_number
 103 0060               
 104 0060 22100001	        addi    $s0, $s0, 1        # increment s0, from 3 to 4 and so on until reaches to MAX
 105 0064               
 106 0064 08000011	        j       search_loop
 107 0068               skip:
 108 0068 22100001	        addi    $s0, $s0, 1           # increments s0 to next integer
 109 006c 08000011	        j       search_loop
 110 0070               Exit:
 111 0070               
 112 0070               
 113 0070               
 114 0070               
 115 0070               # ###### END STUDENT CODE BLOCK 1 ######
 116 0070               # ######################################
 117 0070               
 118 0070               
 119 0070 8FBF0020	        lw      $ra, 32($sp)    # restore the ra & s reg's from the stack
 120 0074 8FB7001C	        lw      $s7, 28($sp)
 121 0078 8FB60018	        lw      $s6, 24($sp)
 122 007c 8FB50014	        lw      $s5, 20($sp)
 123 0080 8FB40010	        lw      $s4, 16($sp)
 124 0084 8FB3000C	        lw      $s3, 12($sp)
 125 0088 8FB20008	        lw      $s2, 8($sp)
 126 008c 8FB10004	        lw      $s1, 4($sp)
 127 0090 8FB00000	        lw      $s0, 0($sp)
 128 0094 23BD0028	        addi    $sp,$sp,40      # clean up stack
 129 0098 03E00008		jr	$ra
 130 009c               
 131 009c               #
 132 009c               # Name:		is_prime 
 133 009c               #
 134 009c               # Description:	checks to see if the num passed in is prime
 135 009c               # Arguments:  	a0	The number to test to see if prime
 136 009c               # Returns: 	v0	a value of 1 if the number in a0 is prime
 137 009c               #			a value of 0 otherwise
 138 009c               #
 139 009c               
 140 009c               is_prime:
 141 009c 23BDFFD8	        addi    $sp,$sp,-40    	# allocate stackframe (doubleword aligned)
 142 00a0 AFBF0020	        sw      $ra, 32($sp)    # store the ra & s reg's on the stack
 143 00a4 AFB7001C	        sw      $s7, 28($sp)
 144 00a8 AFB60018	        sw      $s6, 24($sp)
 145 00ac AFB50014	        sw      $s5, 20($sp)
 146 00b0 AFB40010	        sw      $s4, 16($sp)
 147 00b4 AFB3000C	        sw      $s3, 12($sp)
 148 00b8 AFB20008	        sw      $s2, 8($sp)
 149 00bc AFB10004	        sw      $s1, 4($sp)
 150 00c0 AFB00000	        sw      $s0, 0($sp)
 151 00c4               
 152 00c4               # ######################################
 153 00c4               # ##### BEGIN STUDENT CODE BLOCK 2 #####
 154 00c4               
 155 00c4 34100002	        li      $s0, 2                  # load immediate (put 2 into register $s0)
 156 00c8 00808821	        move    $s1, $a0                # setting s1 = a0 (n) number to test to see if prime 
 157 00cc               divisor_loop:
 158 00cc 0211082A	        bge     $s0, $s1, prime         # if s0 (2) >= s1 (n) then return 1
     00d0 10200005
 159 00d4               
 160 00d4 0230001A	        div     $s1, $s0                # divide s1 (n) \ s0 (2)
 161 00d8 00004010	        mfhi    $t0                     # t0 = n % 2
 162 00dc 11000004	        beq $t0, $zero, not_prime       # if remainder is 0, then it's not prime
 163 00e0               
 164 00e0 22100001	        addi    $s0, $s0, 1             # incrementing method, to proceed from 2 to 3 and so on...
 165 00e4 08000033	        j       divisor_loop            # jumps back to loop again with new $s0 value 
 166 00e8               prime:
 167 00e8 34020001	        li      $v0, 1                  # sets return value to 1
 168 00ec 0800003D	        j       end_is_prime            # jumps to end the function 
 169 00f0               not_prime: 
 170 00f0 34020000	        li      $v0, 0                  # sets return value to 0
 171 00f4               
 172 00f4               end_is_prime:
 173 00f4               # ###### END STUDENT CODE BLOCK 2 ######
 174 00f4               # ######################################
 175 00f4               
 176 00f4 8FBF0020	        lw      $ra, 32($sp)    # restore the ra & s reg's from the stack
 177 00f8 8FB7001C	        lw      $s7, 28($sp)
 178 00fc 8FB60018	        lw      $s6, 24($sp)
 179 0100 8FB50014	        lw      $s5, 20($sp)
 180 0104 8FB40010	        lw      $s4, 16($sp)
 181 0108 8FB3000C	        lw      $s3, 12($sp)
 182 010c 8FB20008	        lw      $s2, 8($sp)
 183 0110 8FB10004	        lw      $s1, 4($sp)
 184 0114 8FB00000	        lw      $s0, 0($sp)
 185 0118 23BD0028	        addi    $sp,$sp,40      # clean up the stack
 186 011c 03E00008		jr	$ra
 187 0120               
 188 0120               #
 189 0120               # Name;		print_number 
 190 0120               #
 191 0120               # Description:	This routine reads a number then a newline to stdout
 192 0120               # Arguments:	a0,the number to print
 193 0120               # Returns:	nothing
 194 0120               #
 195 0120               print_number:
 196 0120               
 197 0120 34020001	        li 	$v0,PRINT_INT
 198 0124 0000000C	        syscall			#print a0
 199 0128               
 200 0128 3C040000	        la	$a0, newline
     012c 34840000
 201 0130 34020004	        li      $v0,PRINT_STRING
 202 0134 0000000C	        syscall			#print a newline
 203 0138               
 204 0138 03E00008	        jr      $ra


